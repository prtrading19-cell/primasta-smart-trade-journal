NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
OPENAI_API_KEY=your-openai-api-key
TWELVE_DATA_API_KEY=your-twelve-data-api-key

# ------------------------------------------------------------------
# MT5 LIVE BROKER INTEGRATION (Phase 24)
# Server-side only. Credentials NEVER reach the frontend or logs.
# ------------------------------------------------------------------
# Master switch for the MT5 broker layer.
MT5_ENABLED=false

# --- Credentials (optional until a live gateway is configured) ---
# Leave blank in local development. Set only in secure server env files.
MT5_LOGIN=
MT5_PASSWORD=
MT5_INVESTOR_PASSWORD=
MT5_SERVER=

# --- Broker metadata (display only) ---
MT5_BROKER_NAME=My Broker
MT5_TERMINAL_PATH=

# --- Gateway transport ---
# One of: unavailable | bridge | python | windows | docker
# "unavailable" (default) = architecture is live but order transmission is
# disabled until a secure MT5 gateway service is configured and connected.
#
# "python" = live gateway. Start the local Python service first:
#   cd mt5-gateway && pip install -r requirements.txt
#   python -m uvicorn app.main:app --host 127.0.0.1 --port 8765
# MT5_GATEWAY_URL defaults to http://127.0.0.1:8765 when left empty.
MT5_GATEWAY_TRANSPORT=unavailable
MT5_GATEWAY_URL=

# --- Execution defaults ---
MT5_MAGIC=190624
MT5_DEVIATION=20

# --- Safety engine ---
MT5_SAFETY_MAX_RISK_PERCENT=2
MT5_SAFETY_MAX_LOTS=10
MT5_SAFETY_MAX_DAILY_LOSS_PERCENT=5
MT5_SAFETY_MAX_DAILY_TRADES=10
MT5_SAFETY_MAX_DRAWDOWN_PERCENT=20
MT5_SAFETY_MIN_FREE_MARGIN=1000
MT5_SAFETY_TRADING_DAYS=1,2,3,4,5
MT5_SAFETY_TRADING_OPEN_HOUR=0
MT5_SAFETY_TRADING_CLOSE_HOUR=24
MT5_SAFETY_KILL_SWITCH=false
