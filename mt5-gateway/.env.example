# MT5 Gateway service environment (optional).
# Copy to .env and fill only on the trading host. Values here are used by the
# Python service as a fallback when the Next.js transport does not forward
# credentials. Keep this file OUT of the repository (.env is git-ignored).
MT5_LOGIN=
MT5_PASSWORD=
MT5_INVESTOR_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=
MT5_MAGIC=190624
MT5_DEVIATION=20

# --- At-rest credential encryption (Phase 25A) ---
# Optional. When empty, a random AES-256 key is generated on first use and
# stored in <gateway>/data/gateway.key (git-ignored). Set a strong random
# value here to pin the key across deployments. Saved MT5 passwords are
# encrypted with AES-256-GCM and never stored or returned in plain text.
MT5_GATEWAY_ENCRYPTION_KEY=
